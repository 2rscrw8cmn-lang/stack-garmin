<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <iq:application entry="StackWatchFaceApp" id="32946A42C2114D898A742344DD6E3276" launcherIcon="@Drawables.LauncherIcon" minSdkVersion="5.2.0" name="@Strings.AppName" type="watchface">
    <iq:products>
      <iq:product id="fr265"/>
    </iq:products>
    <iq:permissions>
      <!-- Body Battery is one of the selectable StackMetrics slots. -->
      <iq:uses-permission id="SensorHistory"/>
      <!-- VO2 max is read from the athlete profile. -->
      <iq:uses-permission id="UserProfile"/>
      <!-- Weekly running distance comes from Garmin's native complication. -->
      <iq:uses-permission id="ComplicationSubscriber"/>
    </iq:permissions>
    <iq:languages><iq:language>eng</iq:language></iq:languages>
    <iq:barrels/>
  </iq:application>
</iq:manifest>
