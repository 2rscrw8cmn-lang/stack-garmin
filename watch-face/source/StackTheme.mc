module StackTheme {
    // Current STACK product palette. Keep the watch face intentionally small:
    // black canvas, white time, lime primary accent, and a few bright punctuation colors.
    const BG = 0x03070A;
    const TEXT = 0xF6F7F8;
    const MUTED = 0x9CA7B1;
    const SUBTLE = 0x59646E;
    const DARK = 0x182129;

    const LIME = 0xA6FF1A;
    const BLUE = 0x287DFF;
    const PURPLE = 0xA14CFF;
    const YELLOW = 0xFFD21A;
    const CYAN = 0x2BC6D6;
    const ORANGE = 0xFF9F43;
    const PINK = 0xFF5AC8;

    // Always-on pixels should remain sparse and subdued on AMOLED.
    const AOD = 0x343C43;
}
