module StackTheme {
    // Canonical STACK palette for the OFFSET watch face. Time is the subject;
    // every other colour here is punctuation.
    const BG = 0x03070A;
    const TEXT = 0xF6F7F8;

    const LIME = 0xA6FF1A;
    const BLUE = 0x287DFF;
    const PURPLE = 0xA14CFF;
    const YELLOW = 0xFFD21A;
    const CYAN = 0x2BC6D6;
    const PINK = 0xFF5AC8;

    // Always-on pixels stay sparse and subdued on AMOLED.
    const AOD = 0x343C43;
}
